# CarPricePredictor Environment Configuration
# Copy this file to .env and adjust variables as needed for your deployment.

# Environment mode: 'development', 'production', or 'testing'
FLASK_ENV=development

# Secret key for session security and crypto
SECRET_KEY=change-me-to-a-secure-random-secret-key

# Server binding host and port
HOST=0.0.0.0
PORT=5000

# Path to serialized ML model joblib artifact
MODEL_PATH=car_price_model.joblib

# Rate limiting settings
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_STORAGE_URI=memory://

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
